# Cloud Viewer Configuration
# Copy this file to .env and fill in your values

# Storage Type: local, azure, or aws
STORAGE_TYPE=local

# Storage Path
# For local: path to data directory
# For azure: container name
# For aws: bucket name
STORAGE_PATH=../data/blob_export

# Azure Blob Storage (required if STORAGE_TYPE=azure)
# AZURE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...

# AWS S3 (required if STORAGE_TYPE=aws)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1

# Server Configuration
PORT=5000
DEBUG=false
